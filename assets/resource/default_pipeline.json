{
    "Default": {
        "rate_limit": 500,
        "timeout": 30000,
        "pre_delay": 150,
        "post_delay": 500,
        "on_error": "FatalExit"
    },
    "OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "threshold": 0.3
            }
        }
    },
    "TemplateMatch": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "",
                "threshold": 0.75
            }
        }
    },
    "Click": {
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    }
}
